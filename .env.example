# Copy to .env for local, or set in Vercel Project Settings → Environment Variables

APP_NAME=Azzeman Hotel
APP_URL=https://your-project.vercel.app
APP_ENV=production
APP_DEBUG=false
EMAIL_BASE_URL=https://your-project.vercel.app/

# MySQL (required for bookings/admin — use a remote host Vercel can reach)
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Chat / AI (optional)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# SMTP (optional until you connect mail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Azzeman Hotel
SMTP2_HOST=
SMTP2_PORT=465
SMTP2_USER=
SMTP2_PASS=
SMTP2_FROM_EMAIL=
SMTP2_FROM_NAME=Azzeman Hotel
ADMIN_EMAIL=reservation@azzemanhotel.com
ADMIN_EMAILS=reservation@azzemanhotel.com,admin@azzemanhotel.com

# Brevo transactional email (set later — booking approve/reject)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=reservation@azzemanhotel.com
BREVO_SENDER_NAME=Azzeman Hotel
